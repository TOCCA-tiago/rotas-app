# Mesmo projeto Supabase do CRM (copie os valores do projeto do CRM na Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mesmo token da API v2 do Tiny usado no CRM
TINY_API_TOKEN=

# Endereço de saída/retorno das entregas (depósito)
ORIGEM_ENDERECO=

# Opcional: chave da Geocoding API do Google (localização bem mais precisa; sem ela usa o OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# Opcional: servidor OSRM próprio (padrão: servidor público de demonstração)
OSRM_URL=
